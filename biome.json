{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/src/gen",
      "!**/routeTree.gen.ts",
      "!apps/bff/openapi.json",
      "!docs",
      "!**/*.md",
      "!**/*.yaml",
      "!**/*.yml"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "parser": { "unsafeParameterDecoratorsEnabled": true },
    "formatter": { "quoteStyle": "single", "semicolons": "always" }
  },
  "linter": { "rules": { "preset": "recommended" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [{ "includes": ["apps/web/**"], "javascript": { "formatter": { "semicolons": "asNeeded" } } }]
}
